{
    "extends": "./tsconfig.json",
    "include": [
        "src/**/*.test.ts",
        "src/**/__tests__/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "compilerOptions": {
        "types": [
            "jest",
            "node"
        ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    }
}