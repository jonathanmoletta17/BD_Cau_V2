# Environment variables for GLPI Ticket Agent

# Feature Flag: Enable new TOD architecture
ENABLE_TOD=true

# Server
PORT=5000

# LLM Configuration
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:latest

# Redis
REDIS_URL=redis://localhost:6379

# GLPI Configuration
GLPI_URL=http://your-glpi-url/apirest.php
GLPI_USER=your-user
GLPI_PASSWORD=your-password
