# AI Exclusion File (.aiexclude)
# Forces Gemini Code Assist / Cloud Code to ignore these files during RAG indexing.

# Dependencies
node_modules/
__pycache__/
venv/
.venv/
env/

# Build Outputs
dist/
build/
.next/
out/
coverage/

# Version Control
.git/
.svn/

# IDE & Configs
.vscode/
.idea/
.DS_Store
*.log

# Lockfiles (Not semantic code, usually too large)
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock
