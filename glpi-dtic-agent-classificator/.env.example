# GLPI Agent Configuration Example
# Copie este arquivo para .env e ajuste os valores

ENVIRONMENT=test
AGENT_DEVICE=cpu

# --- GLPI TEST ---
GLPI_TEST_URL=http://test-glpi.example.com/apirest.php
GLPI_TEST_USER_TOKEN=your_test_user_token_here
GLPI_TEST_APP_TOKEN=your_test_app_token_here

# --- GLPI PROD ---
GLPI_PROD_URL=http://prod-glpi.example.com/apirest.php
GLPI_PROD_USER_TOKEN=your_prod_user_token_here
GLPI_PROD_APP_TOKEN=your_prod_app_token_here

# --- THRESHOLDS ---
AUTO_CONFIRM_THRESHOLD=0.90
KEEP_CURRENT_THRESHOLD=0.90
MARGINAL_DIFF=0.05
DISCREPANCY_ACT=0.10
SUBCATEGORY_MARGIN=0.05
SUBCATEGORY_MIN=0.80

# --- SYSTEM ---
SANDBOX=true
LOG_DIR=logs
REPORT_DIR=reports
CACHE_TTL_SECONDS=60
EMB_BATCH_SIZE=32
EMBEDDING_BACKEND=stub
