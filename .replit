modules = ["bash", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GLPI Data Service"

[[workflows.workflow]]
name = "GLPI Data Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd glpi-data-service && python -m uvicorn src.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
