# ==============================================
# BASE ENVIRONMENT CONFIGURATION (ROOT)
# ==============================================
ENVIRONMENT=development
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# ==============================================
# POSTGRESQL DATABASE
# ==============================================
POSTGRES_DB=glpi_data
POSTGRES_USER=glpi_user
POSTGRES_PASSWORD=glpi_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================
# GLPI API CONFIGURATION (SHARED)
# ==============================================

# --- GLPI PROD (Reading Only) ---
GLPI_PROD_URL=http://glpi.example.com/apirest.php
GLPI_PROD_USER_TOKEN=your_prod_user_token_here
GLPI_PROD_APP_TOKEN=your_prod_app_token_here

# --- GLPI TEST (Write Access) ---
GLPI_TEST_URL=http://glpi-test.example.com/apirest.php
GLPI_TEST_USER_TOKEN=your_test_user_token_here
GLPI_TEST_APP_TOKEN=your_test_app_token_here

# --- GLPI DTIC Context ---
GLPI_DTIC_URL=http://glpi.example.com/apirest.php
GLPI_DTIC_USER_TOKEN=your_dtic_user_token_here
GLPI_DTIC_APP_TOKEN=your_dtic_app_token_here

# --- GLPI SIS Context ---
GLPI_SIS_URL=http://glpi.example.com/sis/apirest.php
GLPI_SIS_USER_TOKEN=your_sis_user_token_here
GLPI_SIS_APP_TOKEN=your_sis_app_token_here

# ==============================================
# AGENT CLASSIFICATOR SETTINGS
# ==============================================
AGENT_DEVICE=cpu
AUTO_CONFIRM_THRESHOLD=0.90
KEEP_CURRENT_THRESHOLD=0.90
MARGINAL_DIFF=0.05
DISCREPANCY_ACT=0.10
SUBCATEGORY_MARGIN=0.05
SUBCATEGORY_MIN=0.80
SANDBOX=true
CACHE_TTL_SECONDS=60
EMB_BATCH_SIZE=32
EMBEDDING_BACKEND=stub

# ==============================================
# LLM CURATOR (LOCAL)
# ==============================================
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=mistral-nemo-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=500
LLM_TIMEOUT=60

# ==============================================
# DATA SERVICE & SYNC
# ==============================================
SYNC_INTERVAL=5
SYNC_FULL_DAYS_LOOKBACK=365
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin

# ==============================================
# AI & AGENT CONFIGURATION (NEW STANDARD)
# ==============================================

# HuggingFace (Required for gated models)
HF_TOKEN=hf_...

# LLM Service Parameters (Centralized vLLM)
LLM_BASE_URL=http://localhost:9000/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
LLM_API_KEY=sk-antigravity

# Agent Hardware
AGENT_DEVICE=cuda

# Model & Cache Paths
# Standard Location: C:\AI_DATA

