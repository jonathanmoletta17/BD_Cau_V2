services:
  # ==========================================
  # Core Infrastructure
  # ==========================================
  postgres:
    image: postgres:15-alpine
    container_name: bd_cau_postgres
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-glpi_data}
      - POSTGRES_USER=${POSTGRES_USER:-glpi_user}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-glpi_dev_password}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - app_network
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-glpi_user} -d ${POSTGRES_DB:-glpi_data}" ]
      interval: 10s
      timeout: 5s
      retries: 5

  # ==========================================
  # Backend Services
  # ==========================================
  data-service:
    build:
      context: ./glpi-data-service
      dockerfile: Dockerfile
    container_name: glpi-data-service
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
      - POSTGRES_USER=${POSTGRES_USER:-glpi_user}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-glpi_dev_password}
      - POSTGRES_DB=${POSTGRES_DB:-glpi_data}
      - GLPI_DTIC_URL=${GLPI_DTIC_URL}
      - GLPI_DTIC_APP_TOKEN=${GLPI_DTIC_APP_TOKEN}
      - GLPI_DTIC_USER_TOKEN=${GLPI_DTIC_USER_TOKEN}
      - GLPI_SIS_URL=${GLPI_SIS_URL:-}
      - GLPI_SIS_APP_TOKEN=${GLPI_SIS_APP_TOKEN:-}
      - GLPI_SIS_USER_TOKEN=${GLPI_SIS_USER_TOKEN:-}
      - PYTHONUNBUFFERED=1
      - LOG_LEVEL=INFO
    volumes:
      - ./glpi-data-service/logs:/app/logs
    networks:
      - app_network
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: [ "CMD", "curl", "-f", "http://localhost:8000/health" ]
      interval: 30s
      timeout: 10s
      retries: 3

  # ==========================================
  # Frontend Applications
  # ==========================================

  # DTIC Dashboard - Porta 3005 (3000 reservada para Open WebUI)
  dtic-dashboard:
    build:
      context: ./glpi-dtic-dashboard/frontend
      dockerfile: ../Dockerfile
    container_name: dtic-dashboard
    restart: unless-stopped
    ports:
      - "3005:80"
    networks:
      - app_network
    depends_on:
      - data-service

  # SIS Dashboard - Porta 3001
  sis-dashboard:
    build:
      context: ./glpi-sis-dashboard/frontend
      dockerfile: ../Dockerfile
    container_name: sis-dashboard
    restart: unless-stopped
    ports:
      - "3001:80"
    networks:
      - app_network
    depends_on:
      - data-service

  # DTIC Smart Search - Porta 3002
  dtic-smart-search:
    build:
      context: ./glpi-dtic-smart-search/frontend
      dockerfile: ../Dockerfile
    container_name: dtic-smart-search
    restart: unless-stopped
    ports:
      - "3002:80"
    networks:
      - app_network
    depends_on:
      - data-service

  # SIS Smart Search - Porta 3003
  sis-smart-search:
    build:
      context: ./glpi-sis-smart-search/frontend
      dockerfile: ../Dockerfile
    container_name: sis-smart-search
    restart: unless-stopped
    ports:
      - "3003:80"
    networks:
      - app_network
    depends_on:
      - data-service

  # SIS Carregadores Dashboard - Porta 3004
  sis-carregadores:
    build:
      context: ./glpi-sis-carregadores-dashboard/frontend
      dockerfile: ../Dockerfile
    container_name: sis-carregadores
    restart: unless-stopped
    ports:
      - "3004:80"
    networks:
      - app_network
    depends_on:
      - data-service

networks:
  app_network:
    driver: bridge

volumes:
  postgres_data:
    driver: local
